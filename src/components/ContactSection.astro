---
// ページ下部のお問い合わせ欄。ヘッダーの「お問い合わせ」はここへ移る（id="contact"）
import { company } from '../lib/site';
import { type Lang, t } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'ja' } = Astro.props;

const telHref = (tel: string) => `tel:${tel.replace(/-/g, '')}`;
const branchLabels = [t(lang, 'contactBranchMatsuyama'), t(lang, 'contactBranchTokyo')];
---
<section id="contact" class="contact" data-testid="contact-section">
  <div class="contact-inner">
    <div class="contact-heading">
      <p class="eyebrow">CONTACT</p>
      <span class="eyebrow-line" aria-hidden="true"></span>
      <h2 class="title-sp">{t(lang, 'contactTitle')}</h2>
    </div>

    <div class="contact-body">
      <div class="contact-intro">
        <h2 class="title-pc">{t(lang, 'contactTitle')}</h2>
        <p class="lead-pc">{t(lang, 'contactLeadPc')}</p>
        <p class="lead-sp">{t(lang, 'contactLeadSp')}</p>
      </div>

      <dl class="contact-list">
        {company.contacts.map((c, i) => (
          <div class="contact-row">
            <dt>{branchLabels[i] ?? c.label}</dt>
            <dd><a href={telHref(c.tel)} data-testid="contact-tel">{c.tel}</a></dd>
          </div>
        ))}
        <div class="contact-row contact-row--mail">
          <dt>
            <span class="label-pc">{t(lang, 'contactMail')}</span>
            <span class="label-sp">{t(lang, 'contactMailSp')}</span>
          </dt>
          <dd><a href={`mailto:${company.email}`} data-testid="contact-mail">{company.email}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-sub);
    color: var(--color-white);
    scroll-margin-top: var(--header-height-pc);
    min-height: 460px;
    display: flex;
    align-items: center;
  }

  .contact-inner {
    width: min(100% - 32px, var(--content-width));
    margin-inline: auto;
    padding-block: 80px;
  }

  .contact-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 48px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-en-serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--color-gold);
    letter-spacing: 3.84px;
    text-transform: uppercase;
    line-height: 22px;
    text-align: center;
  }

  .eyebrow-line {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-gold);
  }

  .title-sp,
  .lead-sp,
  .label-sp {
    display: none;
  }

  .contact-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .title-pc {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 28px;
    color: var(--color-bg-soft);
    letter-spacing: 3px;
    line-height: 48px;
  }

  .lead-pc {
    margin: 24px 0 0;
    font-family: var(--font-jp);
    font-weight: 400;
    font-size: 16px;
    color: var(--color-white-78);
    letter-spacing: 0.61px;
    line-height: 27px;
  }

  .contact-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-row {
    display: flex;
    align-items: baseline;
    gap: 30px;
  }

  .contact-row dt {
    flex: 0 0 auto;
    min-width: 67px;
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-bg);
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .contact-row dd {
    margin: 0;
  }

  .contact-row a {
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 20px;
    color: var(--color-gold);
    letter-spacing: 2px;
    line-height: 28px;
    text-decoration: none;
  }

  @media (max-width: 1099px) {
    .contact {
      scroll-margin-top: var(--header-height-sp);
      min-height: 0;
      display: block;
    }

    .contact-inner {
      width: 100%;
      padding: 80px 24px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .contact-heading {
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 0;
    }

    .eyebrow {
      font-size: 14px;
      line-height: 23px;
      text-align: left;
    }

    .contact-heading .eyebrow + .eyebrow-line {
      margin-top: -6px;
    }

    .title-pc,
    .lead-pc,
    .label-pc {
      display: none;
    }

    .title-sp,
    .lead-sp,
    .label-sp {
      display: block;
    }

    .title-sp {
      margin: 0;
      font-family: var(--font-jp);
      font-weight: 600;
      font-size: 20px;
      color: var(--color-white);
      letter-spacing: 0.04em;
      line-height: 1.4;
    }

    .contact-body {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .lead-sp {
      margin: 0;
      font-family: var(--font-jp);
      font-weight: 400;
      font-size: 14px;
      color: var(--color-white-70);
      line-height: 24px;
    }

    .contact-list {
      align-items: center;
      gap: 20px;
      text-align: center;
      width: 100%;
    }

    .contact-row {
      flex-direction: column;
      align-items: center;
      gap: 4px;
      width: 100%;
      text-align: center;
    }

    .contact-row dt {
      flex: none;
      width: 100%;
      font-weight: 400;
      font-size: 14px;
      color: var(--color-white-45);
      letter-spacing: normal;
      line-height: 23px;
      text-align: center;
    }

    .contact-row dd {
      width: 100%;
      text-align: center;
    }

    .contact-row a {
      letter-spacing: 0.04em;
      line-height: 1.4;
      text-align: center;
    }
  }
</style>
