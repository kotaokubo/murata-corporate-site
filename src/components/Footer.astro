---
import { footerNavPc, footerNavSp, sns } from '../lib/site';
import {
  type Lang,
  hrefForLang,
  htmlLang,
  hreflangCode,
  labelWithUntranslatedSuffix, untranslatedSuffix,
  languageSwitchHref,
  langs,
  localizedPath,
  t,
} from '../lib/i18n';
import logoFooter from '../assets/brand/logo-footer.png';
import iconInstagramFooter from '../assets/brand/icons/instagram-footer.svg';
import iconFacebook from '../assets/brand/icons/facebook.svg';

interface Props {
  lang?: Lang;
}
const { lang = 'ja' } = Astro.props;

const year = new Date().getFullYear();
const logoAlt = `${t(lang, 'siteName')} ${t(lang, 'companyNameEn')}`;
const homeHref = localizedPath('/', lang);
const currentPath = Astro.url.pathname;

const footerLabelKey: Record<string, string> = {
  '会社概要': 'footerCompany',
  'オンラインショップ': 'footerShop',
  '採用情報': 'footerRecruit',
  'FAQ': 'footerFaq',
  'お問い合わせ': 'footerContact',
  '新規取引をご希望の方': 'footerPartners',
  'プライバシーポリシー': 'footerPrivacy',
  '事業内容': 'footerBusiness',
  'お知らせ': 'footerNews',
};

const pageKeyFromFooterHref = (href: string): string | null => {
  if (href === '#contact' || href.startsWith('http')) return null;
  if (href === '/#faq' || href === '/en/#faq' || href === '/zh/#faq') return '/';
  if (href.startsWith('/')) {
    const path = href.split('#')[0] || '/';
    if (path === '' || path === '/') return '/';
    return path.endsWith('/') ? path : `${path}/`;
  }
  return null;
};

const resolveFooterItem = (item: { href: string; label: string; external?: boolean }) => {
  const key = footerLabelKey[item.label] ?? 'footerContact';
  const label = t(lang, key);
  const pageKey = pageKeyFromFooterHref(item.href);

  if (item.href === '/#faq' || (pageKey === '/' && item.href.includes('#faq'))) {
    const faqHref = `${localizedPath('/', lang)}#faq`;
    return { ...item, label, displayLabel: label, hrefResolved: faqHref };
  }

  if (item.external || pageKey === null) {
    // 外部のリンク（オンラインショップ）は日本語だけのサイト
    const displayLabel = item.external ? `${label}${untranslatedSuffix(lang)}` : label;
    return { ...item, label, displayLabel, hrefResolved: item.href };
  }

  return {
    ...item,
    label,
    displayLabel: labelWithUntranslatedSuffix(label, pageKey, lang),
    hrefResolved: hrefForLang(pageKey, lang),
  };
};

const pcItems = footerNavPc.map(resolveFooterItem);
const spItems = footerNavSp.map(resolveFooterItem);

const linkAttrs = (item: { href: string; label: string; external?: boolean }) =>
  item.external ? { target: '_blank', rel: 'noopener' } : {};

const isFaq = (label: string) => label === 'FAQ';

const langItems = langs.map((code) => ({
  code,
  label: t(lang, code === 'ja' ? 'langJa' : code === 'en' ? 'langEn' : 'langZh'),
  href: languageSwitchHref(currentPath, code),
  current: code === lang,
  hreflang: hreflangCode[code],
  htmlLangAttr: htmlLang[code],
}));
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top footer-top--pc">
      <a href={homeHref} class="footer-logo">
        <img
          class="footer-logo-img footer-logo-img--pc"
          src={logoFooter.src}
          width="240"
          height="55"
          alt={logoAlt}
        />
      </a>
      <nav class="footer-nav footer-nav--pc" aria-label={t(lang, 'navFooter')}>
        <ul>
          {pcItems.map((item) => (
            <li>
              <a
                href={item.hrefResolved}
                class:list={[{ 'is-en': isFaq(item.label) }]}
                {...linkAttrs(item)}
              >{item.displayLabel}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ul class="footer-sns">
        {sns.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener" aria-label={item.name}>
              {item.name === 'Instagram' ? (
                <img src={iconInstagramFooter.src} width="24" height="24" alt="" />
              ) : (
                <img src={iconFacebook.src} width="24" height="24" alt="" />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-top footer-top--sp">
      <a href={homeHref} class="footer-logo">
        <img
          class="footer-logo-img footer-logo-img--sp"
          src={logoFooter.src}
          width="150"
          height="34"
          alt={logoAlt}
        />
      </a>
      <nav class="footer-nav footer-nav--sp" aria-label={t(lang, 'navFooter')}>
        <ul>
          {spItems.map((item) => (
            <li>
              <a
                href={item.hrefResolved}
                class:list={[{ 'is-en': isFaq(item.label) }]}
                {...linkAttrs(item)}
              >{item.displayLabel}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ul class="footer-sns">
        {sns.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener" aria-label={item.name}>
              {item.name === 'Instagram' ? (
                <img src={iconInstagramFooter.src} width="24" height="24" alt="" />
              ) : (
                <img src={iconFacebook.src} width="24" height="24" alt="" />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <hr class="footer-rule" />

    <p class="lang lang--footer" aria-label={t(lang, 'langLabel')}>
      {langItems.map((item, i) => (
        <>
          {i > 0 && <span class="lang-sep" aria-hidden="true">/</span>}
          {item.current ? (
            <span class="lang-current" aria-current="true">{item.label}</span>
          ) : (
            <a
              class="lang-other"
              href={item.href}
              hreflang={item.hreflang}
              lang={item.htmlLangAttr}
            >{item.label}</a>
          )}
        </>
      ))}
    </p>

    <p class="copyright">© {year} MURATA JEWELRY All Rights Reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-deep);
    color: var(--color-white);
    padding: 64px 0 38px;
  }

  .footer-inner {
    width: min(100% - 32px, var(--content-width));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .footer-top--pc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    width: 100%;
  }

  .footer-top--sp {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .footer-logo {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .footer-logo-img {
    display: block;
    max-width: none;
  }

  .footer-logo-img--pc {
    width: 240px;
    height: 54.545px;
  }

  .footer-logo-img--sp {
    width: 150px;
    height: 34px;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav--pc ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--color-white-70);
    font-family: var(--font-jp);
    font-weight: 400;
  }

  .footer-nav--pc a {
    font-size: 14px;
    white-space: nowrap;
  }

  .footer-nav a.is-en {
    font-family: var(--font-en-serif);
  }

  .footer-nav--sp ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .footer-nav--sp li {
    line-height: 23px;
  }

  .footer-nav--sp a {
    display: block;
    padding: 0;
    min-height: 0;
    font-size: 13px;
    letter-spacing: 1.024px;
    line-height: 23px;
  }

  .footer-sns {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 0;
    padding: 0;
  }

  .footer-sns a {
    display: block;
    line-height: 0;
  }

  .footer-sns img {
    width: 24px;
    height: 24px;
    max-width: none;
  }

  .footer-rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-white-45);
  }

  .lang {
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--font-en-sans);
    font-weight: 400;
  }

  .lang--footer {
    align-self: flex-start;
    height: 32px;
    gap: 10px;
    font-size: 14px;
    letter-spacing: 3.84px;
  }

  .lang-current {
    color: var(--color-white);
  }

  .lang-other {
    color: var(--color-white-70);
    text-decoration: none;
  }

  .lang-sep {
    color: var(--color-white-45);
  }

  .copyright {
    margin: 0;
    font-family: var(--font-en-sans);
    font-weight: 400;
    font-size: 10px;
    color: var(--color-white-45);
    text-align: center;
  }

  @media (max-width: 1099px) {
    .footer {
      padding: 60px 24px 40px;
    }

    .footer-inner {
      width: 100%;
      gap: 20px;
    }

    .footer-top--pc {
      display: none;
    }

    .footer-top--sp {
      display: flex;
    }

    .lang--footer {
      align-self: center;
      height: auto;
      gap: 16px;
      letter-spacing: normal;
      line-height: 23px;
      justify-content: center;
    }
  }
</style>
