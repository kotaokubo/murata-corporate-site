---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, eyebrow, image, imageAlt = '' } = Astro.props;
---
<section class="page-hero">
  {image && (
    <Image
      src={image}
      alt={imageAlt}
      class="page-hero-bg"
      widths={[390, 780, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  )}
  {image && <div class="page-hero-overlay" aria-hidden="true"></div>}
  <div class="page-hero-inner">
    <p class="page-hero-eyebrow">{eyebrow}</p>
    <span class="page-hero-line" aria-hidden="true"></span>
    <h1 class="page-hero-title">{title}</h1>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 300px;
    padding: 0 24px 61px;
    overflow: hidden;
    background: var(--color-navy);
    box-sizing: border-box;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(3, 22, 85, 0.22);
    pointer-events: none;
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .page-hero-eyebrow {
    margin: 0;
    font-family: var(--font-en-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.08;
    letter-spacing: 3.84px;
    color: var(--color-gold);
  }

  .page-hero-line {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-gold);
  }

  .page-hero-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 28px;
    line-height: 42px;
    letter-spacing: 3px;
    color: var(--color-white);
  }

  @media (max-width: 1099px) {
    .page-hero {
      height: 250px;
      padding: 0 24px 59px;
    }

    .page-hero-eyebrow {
      font-size: 14px;
      line-height: 23px;
      letter-spacing: 2px;
    }

    .page-hero-title {
      font-size: 20px;
      line-height: 30px;
      letter-spacing: 3px;
    }
  }
</style>
