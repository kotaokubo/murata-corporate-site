---
interface Props {
  href: string;
  label: string;
  variant?: 'outline' | 'text';
  external?: boolean;
  class?: string;
}
const { href, label, variant = 'outline', external = false, class: className = '' } = Astro.props;
---
<a
  class:list={['cta', `cta--${variant}`, className]}
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>{label}</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--font-jp);
    box-sizing: border-box;
  }

  .cta--outline {
    min-height: 59px;
    padding: 16px 38px;
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.53;
    letter-spacing: 1.9px;
    text-align: center;
  }

  .cta--outline:hover {
    background: rgba(176, 141, 87, 0.08);
  }

  .cta--text {
    color: var(--color-ink);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.73;
    letter-spacing: 0.96px;
    border-bottom: 0.5px solid transparent;
    padding: 0 0 2px;
  }

  .cta--text:hover,
  .cta--text:focus-visible {
    border-bottom-color: var(--color-gold);
  }

  @media (max-width: 1099px) {
    .cta--outline {
      min-height: 52px;
      font-size: 14px;
      letter-spacing: 1.2px;
    }

    .cta--text {
      font-size: 16px;
      letter-spacing: 0.8px;
    }
  }
</style>
