---
interface Props {
  label?: string;
  class?: string;
}
const { label = 'スライド', class: className = '' } = Astro.props;
---
<div class:list={['carousel', className]} data-carousel>
  <div class="carousel-viewport" aria-live="polite">
    <div class="carousel-track" data-carousel-track>
      <slot />
    </div>
  </div>
  <div class="carousel-nav">
    <button type="button" class="carousel-arrow" data-carousel-prev aria-label={`${label}の前へ`}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path d="M11 4.5L6.5 9L11 13.5" fill="none" stroke="#031655" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="carousel-dots" data-carousel-dots role="group" aria-label={`${label}の表示する写真`}></div>
    <button type="button" class="carousel-arrow" data-carousel-next aria-label={`${label}の次へ`}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path d="M7 4.5L11.5 9L7 13.5" fill="none" stroke="#031655" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<script>
  function setupCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-carousel-dots]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !dotsWrap || !prev || !next) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length === 0) return;

    let index = 0;

    dotsWrap.innerHTML = '';
    slides.forEach((_, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'carousel-dot';
      btn.setAttribute('aria-label', `${i + 1}枚目`);
      btn.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(btn);
    });

    const dots = Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>('.carousel-dot'));

    function goTo(i: number) {
      index = (i + slides.length) % slides.length;
      track!.style.transform = `translateX(-${index * 100}%)`;
      // 見えていない写真は、読み上げとキーボードの移動の対象から外す
      slides.forEach((slide, si) => {
        slide.inert = si !== index;
        slide.setAttribute('aria-hidden', si === index ? 'false' : 'true');
      });
      dots.forEach((dot, di) => {
        dot.classList.toggle('is-active', di === index);
        dot.setAttribute('aria-current', di === index ? 'true' : 'false');
      });
    }

    prev.addEventListener('click', () => goTo(index - 1));
    next.addEventListener('click', () => goTo(index + 1));
    goTo(0);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setupCarousel);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    min-width: 0;
  }

  .carousel-viewport {
    overflow: hidden;
    width: 100%;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }

  .carousel-track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin-top: 0;
  }

  .carousel-arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(209, 204, 196, 0.5);
    background: var(--color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .carousel-arrow:hover {
    background: rgba(176, 141, 87, 0.08);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .carousel-dots :global(.carousel-dot) {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border: 0;
    padding: 0;
    background: rgba(209, 204, 196, 0.5);
    cursor: pointer;
  }

  .carousel-dots :global(.carousel-dot.is-active) {
    width: 24px;
    background: var(--color-gold);
  }

  @media (max-width: 1099px) {
    .carousel-arrow {
      width: 36px;
      height: 36px;
    }

    .carousel-dots {
      gap: 8px;
    }

    .carousel-dots :global(.carousel-dot) {
      width: 6px;
      height: 6px;
      border-radius: 3px;
    }

    .carousel-dots :global(.carousel-dot.is-active) {
      width: 20px;
    }
  }
</style>
