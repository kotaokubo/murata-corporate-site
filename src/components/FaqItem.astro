---
import iconPlus from '../assets/brand/icons/plus.svg';
import iconMinus from '../assets/brand/icons/minus.svg';

interface Props {
  question: string;
  answer: string;
  open?: boolean;
}
const { question, answer, open = false } = Astro.props;
---
<details class="faq-item" open={open || undefined}>
  <summary class="faq-q">
    <span class="mark" aria-hidden="true">Q</span>
    <span class="q-text">{question}</span>
    <span class="toggle" aria-hidden="true">
      <img class="icon-plus" src={iconPlus.src} width="16" height="16" alt="" />
      <img class="icon-minus" src={iconMinus.src} width="16" height="16" alt="" />
    </span>
  </summary>
  <div class="faq-a">
    <span class="mark mark-a" aria-hidden="true">A</span>
    <p class="a-text">{answer}</p>
  </div>
</details>

<style>
  .faq-item {
    border-bottom: 1px solid var(--color-navy-12);
    padding: 30px 0;
  }

  .faq-item:first-child {
    border-top: 1px solid var(--color-navy-12);
  }

  .faq-q {
    display: flex;
    align-items: center;
    gap: 20px;
    list-style: none;
    cursor: pointer;
    padding: 0 6px;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .mark {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-bg-soft);
    font-family: var(--font-en-serif);
    font-size: 14.4px;
    line-height: 28px;
    text-align: center;
  }

  .mark-a {
    color: var(--color-white);
    font-weight: 600;
  }

  .q-text {
    flex: 1;
    font-family: var(--font-jp);
    font-size: 16px;
    line-height: 1.73;
    letter-spacing: 0.614px;
    color: var(--color-ink);
  }

  .toggle {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    position: relative;
  }

  .toggle img {
    display: block;
    position: absolute;
    inset: 0;
  }

  .icon-minus {
    opacity: 0;
  }

  .faq-item[open] .icon-plus {
    opacity: 0;
  }

  .faq-item[open] .icon-minus {
    opacity: 1;
  }

  .faq-a {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 16px;
    padding: 0 6px 24px;
  }

  .a-text {
    margin: 0;
    flex: 1;
    font-family: var(--font-jp);
    font-size: 16px;
    line-height: 1.53;
    letter-spacing: 1.9px;
    color: var(--color-ink);
  }

  @media (max-width: 1099px) {
    .faq-item {
      padding: 30px 0;
      border-bottom-color: var(--color-navy-07);
    }

    .faq-item:first-child {
      border-top-color: var(--color-navy-07);
    }

    .faq-q {
      gap: 16px;
      padding: 0;
    }

    .faq-a {
      gap: 16px;
      padding: 0 0 8px;
    }

    .q-text,
    .a-text {
      font-size: 14px;
      letter-spacing: 0.5px;
    }
  }
</style>
