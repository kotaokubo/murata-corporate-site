---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { localizedPath, t } from '../../lib/i18n';

const lang = 'zh' as const;
---
<BaseLayout title={t(lang, 'notFoundTitle')} description={t(lang, 'notFoundDescription')} lang={lang}>
  <PageHero title={t(lang, 'notFoundTitle')} eyebrow="404" />
  <section class="section">
    <div class="container">
      <p>{t(lang, 'notFoundBody')} <a href={localizedPath('/', lang)}>{t(lang, 'notFoundLink')}</a></p>
    </div>
  </section>
</BaseLayout>
