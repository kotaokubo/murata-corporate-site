---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaButton from '../components/CtaButton.astro';
import FaqItem from '../components/FaqItem.astro';
import { isProduction, nav, sns } from '../lib/site';

import heroPc from '../assets/images/top/hero-pc.png';
import heroSp from '../assets/images/top/hero-sp.png';
import heroSpArt from '../assets/images/top/hero-sp-art.png';
import concept1 from '../assets/images/top/concept-1.jpg';
import concept2 from '../assets/images/top/concept-2.jpg';
import aboutImg from '../assets/images/top/about.jpg';
import onlineShopImg from '../assets/images/top/online-shop.jpg';

import iconGlobe from '../assets/brand/icons/globe.svg';
import iconSearch from '../assets/brand/icons/search.svg';
import iconStar from '../assets/brand/icons/star.svg';
import iconPackage from '../assets/brand/icons/package.svg';
import iconWrench from '../assets/brand/icons/wrench.svg';
import iconTruck from '../assets/brand/icons/truck.svg';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('src/content/pages/home.yml が見つかりません');
const t = homeEntry.data;

const news = (await getCollection('news', ({ data }) => (isProduction ? !data.draft : true)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');

const shopUrl = nav.find((n) => n.label === 'オンラインショップ')?.href ?? '';
const instagramUrl = sns.find((s) => s.name === 'Instagram')?.href ?? '';

const stepIcons = [iconGlobe, iconSearch, iconStar, iconPackage, iconWrench, iconTruck];
const instagramImages = t.instagram.images;

const faqVisible = t.faq.items.filter((item) => item.answer.trim().length > 0);

const nl = (s: string) => s.replace(/\n/g, '<br />');
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <!-- HERO -->
  <section class="hero" aria-label="メインビジュアル">
    <div class="hero-pc">
      <Image
        src={heroPc}
        alt="ジュエリーを身に着けた女性のメインビジュアル"
        class="hero-pc-img"
        widths={[720, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-sp">
      <div class="hero-sp-bg">
        <Image src={heroSp} alt="" class="hero-sp-bg-img" widths={[390, 780]} sizes="100vw" loading="eager" />
      </div>
      <div class="hero-sp-art-wrap">
        <Image
          src={heroSpArt}
          alt="ジュエリーを身に着けた女性"
          class="hero-sp-art"
          widths={[390, 780]}
          sizes="100vw"
          loading="eager"
        />
      </div>
      <p class="hero-catch" set:html={nl(t.hero.catchphrase)} />
      <div class="hero-scroll" aria-hidden="true">
        <span>{t.hero.scroll}</span>
        <span class="hero-scroll-dot"></span>
      </div>
    </div>
  </section>

  <!-- CONCEPT -->
  <section class="concept">
    <div class="inner">
      <div class="concept-grid">
        <div class="concept-copy">
          <SectionHeading eyebrow={t.concept.eyebrow} />
          <h2 class="concept-title concept-title-pc" set:html={nl(t.concept.title)} />
          <h2 class="concept-title concept-title-sp">{t.concept.sp?.title ?? t.concept.title}</h2>
          <p class="body concept-body-pc" set:html={nl(t.concept.body)} />
          <p class="body concept-body-sp" set:html={nl(t.concept.sp?.body ?? t.concept.body)} />
        </div>
        <div class="concept-imgs">
          <Image src={concept1} alt="職人の手元と宝飾品" class="concept-img" width={276} height={342} />
          <Image src={concept2} alt="ジュエリーを身に着けた手元" class="concept-img concept-img-offset" width={276} height={342} />
        </div>
      </div>
    </div>
  </section>

  <!-- OUR BUSINESS -->
  <section class="our-business">
    <div class="inner">
      <div class="ob-head">
        <SectionHeading
          eyebrow={t.ourBusiness.eyebrow}
          title={t.ourBusiness.title}
          align="center"
          titleClass="ob-title-pc"
        />
        <h2 class="ob-title-sp" set:html={nl(t.ourBusiness.sp?.title ?? t.ourBusiness.title)} />
        <p class="body ob-body" set:html={nl(t.ourBusiness.body)} />
      </div>

      <ol class="ob-flow-pc">
        {t.ourBusiness.steps.map((step, i) => (
          <li class="ob-step">
            {i > 0 && <span class="ob-connector" aria-hidden="true" />}
            <div class="ob-step-inner">
              <span class="ob-icon">
                <img src={stepIcons[i].src} width="24" height="24" alt="" />
              </span>
              <span class="ob-labels">
                <span class="ob-en">{step.en}</span>
                <span class="ob-ja">{step.ja}</span>
              </span>
            </div>
          </li>
        ))}
      </ol>

      <ol class="ob-flow-sp">
        {t.ourBusiness.steps.map((step, i) => (
          <li class="ob-step-sp">
            <span class="ob-timeline" aria-hidden="true">
              <span class="ob-dot" />
              {i < t.ourBusiness.steps.length - 1 && <span class="ob-line" />}
            </span>
            <div class="ob-step-sp-text">
              <span class="ob-en">{step.en}</span>
              <span class="ob-ja">{step.ja}</span>
            </div>
          </li>
        ))}
      </ol>

      <div class="ob-cta">
        <CtaButton href="/business/" label={t.ourBusiness.ctaLabel} />
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about">
    <div class="inner about-grid">
      <div class="about-visual">
        <Image
          src={aboutImg}
          alt="村田宝飾のジュエリーを手にする様子"
          class="about-photo"
          width={494}
          height={330}
        />
      </div>
      <div class="about-photo-sp">
        <Image src={aboutImg} alt="村田宝飾のジュエリーを手にする様子" class="about-photo-sp-img" width={342} height={219} />
      </div>
      <div class="about-copy">
        <SectionHeading eyebrow={t.about.eyebrow} title={t.about.title} titleClass="about-title" />
        <p class="eyebrow-sp">{t.about.sp?.eyebrow ?? t.about.eyebrow}</p>
        <h2 class="about-title-sp">{t.about.title}</h2>
        <p class="body about-body-pc">{t.about.body}</p>
        <p class="body about-body-sp" set:html={nl(t.about.sp?.body ?? t.about.body)} />
        <div class="about-cta about-cta-pc">
          <CtaButton href="/company/" label={t.about.ctaLabel} variant="text" />
        </div>
        <div class="about-cta about-cta-sp">
          <CtaButton href="/company/" label={t.about.ctaLabel} />
        </div>
      </div>
    </div>
  </section>

  <!-- RECRUIT -->
  <section class="recruit">
    <div class="recruit-band" aria-hidden="true"></div>
    <div class="inner recruit-grid">
      <div class="recruit-left">
        <SectionHeading eyebrow={t.recruit.eyebrow} title={t.recruit.title} dark titleClass="recruit-title" />
        <p class="recruit-lead recruit-lead-pc" set:html={nl(t.recruit.lead)} />
        <p class="recruit-lead recruit-lead-sp">{t.recruit.sp?.lead ?? t.recruit.lead}</p>
        <div class="recruit-cta recruit-cta-pc">
          <CtaButton href="/recruit/" label={t.recruit.ctaLabel} />
        </div>
      </div>
      <div class="recruit-right">
        <ul class="recruit-cards">
          {t.recruit.cards.map((card) => (
            <li>
              <a href="/recruit/" class="recruit-card">
                <span class="recruit-card-title">{card.title}</span>
                <span class="recruit-card-link">{card.linkLabel}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="recruit-cta recruit-cta-sp">
          <CtaButton href="/recruit/" label={t.recruit.sp?.ctaLabel ?? t.recruit.ctaLabel} />
        </div>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="news">
    <div class="inner news-grid">
      <div class="news-head">
        <SectionHeading eyebrow={t.news.eyebrow} title={t.news.title} />
      </div>
      <div class="news-main">
        <ul class="news-list">
          {news.map((n) => (
            <li class="news-item">
              <a href={`/news/${n.id}/`} class="news-row">
                <time class="news-date" datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
                <span class:list={['news-tag', `is-${n.data.category.toLowerCase()}`]}>{n.data.category}</span>
                {n.data.draft && <span class="draft-badge">下書き</span>}
                <span class="news-title">{n.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="news-cta">
          <CtaButton href="/news/" label={t.news.ctaLabel} variant="text" class="news-cta-pc" />
          <CtaButton href="/news/" label={t.news.ctaLabel} class="news-cta-sp" />
        </div>
      </div>
    </div>
  </section>

  <!-- ONLINE SHOP -->
  <section class="online-shop">
    <div class="inner online-grid">
      <div class="online-copy">
        <SectionHeading eyebrow={t.onlineShop.eyebrow} title={t.onlineShop.title} />
        <p class="body online-body-pc" set:html={nl(t.onlineShop.body)} />
        <p class="body online-body-sp">{t.onlineShop.sp?.body ?? t.onlineShop.body}</p>
        <div class="online-actions">
          <CtaButton href={shopUrl} label={t.onlineShop.ctaLabel} external />
          <p class="online-note">{t.onlineShop.note}</p>
        </div>
      </div>
      <div class="online-visual">
        <Image
          src={onlineShopImg}
          alt="The Jewelry Concierge オンラインショップのイメージ"
          class="online-img"
          width={614}
          height={432}
        />
        <p class="online-overlay">{t.onlineShop.overlay}</p>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="instagram">
    <div class="inner">
      <div class="ig-head">
        <SectionHeading eyebrow={t.instagram.eyebrow} align="center" />
        <h2 class="ig-title-sp">{t.instagram.title}</h2>
      </div>
      {instagramImages.length > 0 && (
        <ul class="ig-grid">
          {instagramImages.map((img) => (
            <li>
              <a href={instagramUrl} target="_blank" rel="noopener" class="ig-item">
                <Image src={img.src} alt={img.alt} width={267} height={267} />
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="ig-cta">
        <CtaButton href={instagramUrl} label={t.instagram.ctaLabel} external />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="faq">
    <div class="inner">
      <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} align="center" />
      <div class="faq-list">
        {faqVisible.map((item, i) => (
          <FaqItem question={item.question} answer={item.answer} open={i === 0} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inner {
    width: min(100% - 48px, var(--content-width));
    margin-inline: auto;
  }

  .body {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.73;
    letter-spacing: 0.614px;
    color: var(--color-ink);
  }

  /* ===== HERO ===== */
  .hero {
    background: var(--color-navy-deep);
    position: relative;
    overflow: hidden;
  }

  .hero-pc {
    display: flex;
    justify-content: center;
    align-items: stretch;
    height: 765px;
    max-height: min(765px, calc(100vw * 765 / 1920));
    min-height: 420px;
    background: var(--color-navy-deep);
  }

  .hero-pc-img {
    width: min(100%, 1440px);
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-sp {
    display: none;
  }

  /* ===== CONCEPT ===== */
  .concept {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: 470px 1fr;
    gap: 80px;
    align-items: center;
  }

  .concept-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .concept-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 28px;
    line-height: 48px;
    letter-spacing: 3px;
    color: var(--color-navy);
  }

  .concept-title-sp,
  .concept-body-sp {
    display: none;
  }

  .concept-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .concept-img {
    width: 100%;
    height: auto;
    aspect-ratio: 276 / 342;
    object-fit: cover;
    display: block;
  }

  /* ===== OUR BUSINESS ===== */
  .our-business {
    background: var(--color-bg);
    padding: 120px 0;
  }

  .ob-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    margin-bottom: 72px;
  }

  .ob-title-sp {
    display: none;
  }

  .ob-body {
    max-width: 880px;
    line-height: 30px;
    letter-spacing: 0.6px;
    text-align: center;
  }

  .ob-flow-pc {
    list-style: none;
    margin: 0;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .ob-flow-sp {
    display: none;
  }

  .ob-step {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .ob-step-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 133px;
  }

  .ob-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ob-labels {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    min-height: 40px;
  }

  .ob-en {
    font-family: var(--font-en-sans);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--color-gold);
    text-align: center;
    line-height: 14px;
  }

  .ob-ja {
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 15px;
    line-height: 22px;
    color: var(--color-ink);
    text-align: center;
  }

  .ob-connector {
    position: absolute;
    left: -30px;
    top: 32px;
    width: 60px;
    height: 1.5px;
    background: var(--color-gold);
  }

  .ob-step:first-child .ob-connector {
    display: none;
  }

  .ob-cta {
    display: flex;
    justify-content: center;
    margin-top: 72px;
  }

  /* ===== ABOUT ===== */
  .about {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 494px 1fr;
    gap: 80px;
    align-items: start;
  }

  .about-visual {
    width: 494px;
    height: 330px;
    overflow: hidden;
    background: var(--color-bg-cream);
  }

  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scaleX(-1);
  }

  .about-photo-sp {
    display: none;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-end;
    max-width: 540px;
    margin-left: auto;
  }

  .about-copy :global(.section-heading) {
    width: 100%;
  }

  .eyebrow-sp,
  .about-title-sp,
  .about-body-sp,
  .about-cta-sp {
    display: none;
  }

  .about-cta {
    margin-top: 28px;
  }

  /* ===== RECRUIT ===== */
  .recruit {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .recruit-band {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(960px, 50%);
    background: linear-gradient(
      135deg,
      var(--color-recruit-grad-from) 0%,
      var(--color-recruit-grad-to) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .recruit-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 523px;
    min-height: 519px;
  }

  .recruit-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 30px;
    padding: 120px 40px 120px 0;
  }

  .recruit-left :global(.recruit-title) {
    font-size: 20px;
    font-weight: 400;
    line-height: 35px;
    letter-spacing: 0.96px;
    color: var(--color-white);
  }

  .recruit-lead {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 28px;
    line-height: 2.47;
    letter-spacing: 3px;
    color: var(--color-bg-soft);
  }

  .recruit-cta-pc {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .recruit-lead-sp,
  .recruit-cta-sp {
    display: none;
  }

  .recruit-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px 80px;
  }

  .recruit-cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recruit-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 30px 16px 30px 4px;
    border-bottom: 1px solid var(--color-white-16);
    text-decoration: none;
    color: inherit;
  }

  .recruit-cards li:first-child .recruit-card {
    border-top: 1px solid var(--color-white-16);
  }

  .recruit-card-title {
    font-family: var(--font-jp);
    font-size: 20px;
    line-height: 1.73;
    letter-spacing: 0.96px;
    color: var(--color-bg-soft);
  }

  .recruit-card-link {
    font-family: var(--font-jp);
    font-size: 16px;
    letter-spacing: 3.84px;
    color: var(--color-gold);
    white-space: nowrap;
  }

  /* ===== NEWS ===== */
  .news {
    padding: 160px 0;
    background: var(--color-bg);
  }

  .news-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    align-items: start;
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news-item {
    border-bottom: 1px solid var(--color-navy-12);
  }

  .news-item:first-child {
    border-top: 1px solid var(--color-navy-12);
  }

  .news-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    padding: 24px 6px;
    text-decoration: none;
    color: inherit;
  }

  .news-date {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--color-navy);
    min-width: 72px;
  }

  .news-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    padding: 4px 12px;
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: 14.4px;
    color: var(--color-bg-soft);
    background: var(--color-navy);
  }

  .news-tag.is-event {
    background: var(--color-gold);
  }

  .news-tag.is-info,
  .news-tag.is-media {
    background: var(--color-navy);
  }

  .news-title {
    flex: 1;
    min-width: 160px;
    font-family: var(--font-jp);
    font-size: 16px;
    line-height: 1.73;
    color: var(--color-ink);
  }

  .news-cta {
    margin-top: 30px;
    display: flex;
    justify-content: flex-end;
  }

  .news-cta :global(.news-cta-sp) {
    display: none;
  }

  /* ===== ONLINE SHOP ===== */
  .online-shop {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .online-grid {
    display: grid;
    grid-template-columns: 469px 1fr;
    gap: 80px;
    align-items: center;
  }

  .online-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .online-body-sp {
    display: none;
  }

  .online-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 20px;
  }

  .online-note {
    margin: 0;
    font-family: var(--font-jp);
    font-size: 12px;
    line-height: 23px;
    letter-spacing: 1.02px;
    color: var(--color-ink);
    text-align: center;
  }

  .online-visual {
    position: relative;
    min-height: 390px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .online-img {
    width: 100%;
    max-width: 614px;
    height: auto;
    aspect-ratio: 614 / 432;
    object-fit: cover;
    display: block;
    transform: scaleX(-1);
  }

  .online-overlay {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-en-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(22px, 2.4vw, 36px);
    letter-spacing: 2.78px;
    color: var(--color-bg-cream);
    text-align: center;
    text-shadow: 0 0 1px #12235a;
    pointer-events: none;
    background: rgba(3, 22, 85, 0.18);
  }

  /* ===== INSTAGRAM ===== */
  .instagram {
    padding: 160px 0;
    background: var(--color-bg);
  }

  .ig-head {
    display: flex;
