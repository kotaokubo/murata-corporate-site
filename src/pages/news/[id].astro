---
// 【仮】お知らせ詳細。デザイン作成中（2026-10-04 時点）。届いたら実装し直す
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { isProduction } from '../../lib/site';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => isProduction ? !data.draft : true);
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---
<BaseLayout title={entry.data.title} description={entry.data.description} ogImage={entry.data.image?.src}>
  <PageHero title="お知らせ" eyebrow="NEWS" />
  <article class="section">
    <div class="container article">
      <p class="meta">
        {entry.data.draft && <span class="draft-badge">下書き</span>}
        <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
        <span class="cat">{entry.data.category}</span>
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.image && <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} widths={[400, 800, 1200]} sizes="(max-width: 800px) 100vw, 800px" />}
      <Content />
      <p><a href="/news/">お知らせ一覧へ戻る</a></p>
    </div>
  </article>
</BaseLayout>
<style>
  .article { max-width: 800px; }
  .meta { display: flex; gap: var(--space-3); color: var(--color-muted); font-size: 0.85rem; }
  .cat { color: var(--color-gold); }
  h1 { font-weight: 500; font-size: 1.5rem; }
</style>
