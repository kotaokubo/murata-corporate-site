---
import HistoryPage from '../../components/pages/HistoryPage.astro';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

const lang = Astro.params.lang as Lang;
---
<HistoryPage lang={lang} />
