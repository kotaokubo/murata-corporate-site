---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaButton from '../components/CtaButton.astro';
import FaqItem from '../components/FaqItem.astro';

import heroImg from '../assets/images/partners/hero.png';
import reason01 from '../assets/images/partners/reason-01.jpg';
import reason02 from '../assets/images/partners/reason-02.jpg';
import reason03 from '../assets/images/partners/reason-03.jpg';
import reason04 from '../assets/images/partners/reason-04.jpg';

const entry = await getEntry('partnersPage', 'partners');
if (!entry) throw new Error('src/content/pages/partners.yml が見つかりません');
const t = entry.data;

const reasonImages = [
  { src: reason01, alt: 'ゴールドのリングやネックレスを並べた陳列台' },
  { src: reason02, alt: 'ピンセットで色石を選り分ける女性' },
  { src: reason03, alt: '工房の作業台で指輪を加工する職人の手元' },
  { src: reason04, alt: '店舗のテーブルでジュエリーを見ながら話す2人' },
];

const faqVisible = t.faq.items.filter((item) => item.answer.trim().length > 0);
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <PageHero
    title={t.pageHero.title}
    titleSp={t.pageHero.sp?.title}
    eyebrow={t.pageHero.eyebrow}
    image={heroImg}
    imageAlt=""
  />

  <!-- INTRO -->
  <section class="intro">
    <div class="inner intro-inner">
      <h2 class="intro-title intro-title-pc">{t.intro.title}</h2>
      <h2 class="intro-title intro-title-sp">{t.intro.sp?.title ?? t.intro.title}</h2>
      <p class="intro-body intro-body-pc">{t.intro.body}</p>
      <p class="intro-body intro-body-sp">{t.intro.sp?.body ?? t.intro.body}</p>
      <div class="intro-actions">
        <CtaButton href="/business/" label={t.intro.ctaBusiness} class="intro-cta-outline intro-cta-business" />
        <CtaButton href="#contact" label={t.intro.ctaContact} variant="fill" class="intro-cta-contact" />
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- REASONS -->
  <section class="reasons">
    <div class="inner">
      <div class="reasons-head">
        <SectionHeading
          eyebrow={t.reasons.eyebrow}
          title={t.reasons.title}
          align="center"
          titleClass="reasons-title-pc"
        />
        <p class="reasons-eyebrow-sp">{t.reasons.sp?.eyebrow ?? t.reasons.eyebrow}</p>
        <span class="reasons-line-sp" aria-hidden="true"></span>
        <h2 class="reasons-title-sp">{t.reasons.sp?.title ?? t.reasons.title}</h2>
      </div>
      <ul class="reasons-grid">
        {t.reasons.items.map((item, i) => (
          <li class="reason-card">
            <Image
              src={reasonImages[i].src}
              alt={reasonImages[i].alt}
              class="reason-img"
              width={496}
              height={200}
            />
            <div class="reason-heading">
              <span class="reason-num">{item.number}</span>
              <h3 class="reason-title reason-title-pc">{item.title}</h3>
              <h3 class="reason-title reason-title-sp">{item.sp?.title ?? item.title}</h3>
            </div>
            <p class="reason-body reason-body-pc">{item.body}</p>
            <p class="reason-body reason-body-sp">{item.sp?.body ?? item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- CONSULTATIONS -->
  <section class="consultations">
    <div class="inner">
      <div class="consult-head">
        <SectionHeading eyebrow={t.consultations.eyebrow} title={t.consultations.title} align="center" />
      </div>
      <ul class="consult-grid">
        {t.consultations.items.map((item) => (
          <li class="consult-card">
            <p class="consult-en consult-en-pc">{item.en}</p>
            <p class="consult-en consult-en-sp">{item.sp?.en ?? item.en}</p>
            <h3 class="consult-title consult-title-pc">{item.title}</h3>
            <h3 class="consult-title consult-title-sp">{item.sp?.title ?? item.title}</h3>
            <ul class="consult-bullets consult-bullets-pc">
              {item.bullets.map((b) => (
                <li>
                  <span class="bullet" aria-hidden="true">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <ul class="consult-bullets consult-bullets-sp">
              {(item.sp?.bullets ?? item.bullets).map((b) => (
                <li>
                  <span class="bullet" aria-hidden="true">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="section-rule section-rule-soft" />

  <!-- FLOW -->
  <section class="flow">
    <div class="inner">
      <div class="flow-head">
        <SectionHeading eyebrow={t.flow.eyebrow} title={t.flow.title} />
        <p class="flow-lead">{t.flow.lead}</p>
      </div>
      <ol class="flow-steps">
        {t.flow.steps.map((step) => (
          <li class="flow-step">
            <span class="flow-num">{step.number}</span>
            <div class="flow-copy">
              <h3 class="flow-step-title">{step.title}</h3>
              <p class="flow-step-body">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- FAQ -->
  {faqVisible.length > 0 && (
  <section class="faq">
    <div class="inner">
      <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} align="center" />
      <div class="faq-list">
        {faqVisible.map((item, i) => (
          <FaqItem question={item.question} answer={item.answer} open={i === 0} />
        ))}
      </div>
    </div>
  </section>
  )}
</BaseLayout>

<style>
  .inner {
    width: min(100% - 48px, var(--content-width));
    margin-inline: auto;
  }

  .section-rule {
    display: block;
    border: 0;
    margin: 0;
    height: 1px;
    background: var(--color-navy-12);
  }

  .section-rule-soft {
    display: none;
  }

  /* ===== INTRO ===== */
  .intro {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .intro-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 24px;
    line-height: 44px;
    letter-spacing: 1.5px;
    color: var(--color-navy);
    white-space: pre-line;
  }

  .intro-title-sp,
  .intro-body-sp {
    display: none;
  }

  .intro-body {
    margin: 0;
    max-width: 1120px;
    font-family: var(--font-jp);
    font-weight: 400;
    font-size: 16px;
    line-height: 32px;
    letter-spacing: 0.8px;
    color: var(--color-ink);
    white-space: pre-line;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 16px;
  }

  .intro-actions :global(.intro-cta-outline) {
    border-radius: 4px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 1.2px;
    padding: 16px 36px;
  }

  /* ===== REASONS ===== */
  .reasons {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .reasons-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 64px;
    text-align: center;
  }

  .reasons-eyebrow-sp,
  .reasons-line-sp,
  .reasons-title-sp {
    display: none;
  }

  .reasons-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .reason-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-white);
    border: 1px solid var(--color-navy-12);
    border-radius: 8px;
  }

  .reason-img {
    width: 100%;
    height: auto;
    aspect-ratio: 496 / 200;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .reason-heading {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .reason-num {
    font-family: var(--font-en-serif);
    font-weight: 600;
    font-size: 20px;
    color: var(--color-gold);
    line-height: 1.2;
  }

  .reason-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.4;
    color: var(--color-navy);
  }

  .reason-title-sp,
  .reason-body-sp {
    display: none;
  }

  .reason-body {
    margin: 0;
    font-family: var(--font-jp);
    font-size: 14px;
    line-height: 24px;
    color: var(--color-ink);
    white-space: pre-line;
  }

  /* ===== CONSULTATIONS ===== */
  .consultations {
    background: var(--color-bg-soft);
    padding: 160px 0;
  }

  .consult-head {
    margin-bottom: 64px;
  }

  .consult-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .consult-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    background: var(--color-white);
    border: 1px solid var(--color-navy-12);
    border-radius: 8px;
  }

  .consult-en {
    margin: 0;
    font-family: var(--font-en-serif);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--color-gold);
  }

  .consult-en-sp,
  .consult-title-sp {
    display: none;
  }

  .consult-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.4;
    color: var(--color-navy);
  }

  .consult-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* .consult-bullets の display:flex より後に置き、PC で SP 用を隠す */
  .consult-bullets-sp {
    display: none;
  }

  .consult-bullets li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-family: var(--font-jp);
    font-size: 14px;
    line-height: 22px;
    color: var(--color-ink);
  }

  .bullet {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-family: var(--font-en-serif);
    font-weight: 600;
    line-height: 22px;
  }

  /* ===== FLOW ===== */
  .flow {
    background: var(--color-bg);
    padding: 160px 0;
  }

  .flow-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 72px;
  }

  .flow-lead {
    margin: 0;
    font-family: var(--font-jp);
    font-size: 16px;
    line-height: 28px;
    color: var(--color-ink);
    white-space: pre-line;
  }

  .flow-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .flow-step {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-navy-12);
    border-radius: 4px;
  }

  .flow-num {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-bg-soft);
    font-family: var(--font-en-serif);
    font-weight: 600;
    font-size: 14.4px;
    line-height: 36px;
    text-align: center;
  }

  .flow-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .flow-step-title {
    margin: 0;
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 18px;
    line-height: 30px;
    letter-spacing: 2px;
    color: var(--color-ink);
  }

  .flow-step-body {
    margin: 0;
    font-family: var(--font-jp);
    font-size: 16px;
    line-height: 28px;
    color: var(--color-ink);
    white-space: pre-line;
  }

  /* ===== FAQ ===== */
  .faq {
    background: var(--color-bg-soft);
    padding: 160px 0;
  }

  .faq-list {
    width: min(100%, 920px);
    margin: 48px auto 0;
  }

  /* ===== SP ===== */
  @media (max-width: 1099px) {
    .inner {
      width: min(100% - 48px, 342px);
    }

    .section-rule {
      display: none;
    }

    .intro {
      padding: 80px 0 60px;
    }

    .intro-inner {
      align-items: stretch;
      gap: 30px;
      text-align: left;
    }

    .intro-title-pc,
    .intro-body-pc {
      display: none;
    }

    .intro-title-sp,
    .intro-body-sp {
      display: block;
    }

    .intro-title {
      font-size: 20px;
      line-height: 1.6;
      letter-spacing: 1px;
    }

    .intro-body {
      font-size: 14px;
      line-height: 1.7;
      letter-spacing: 0.4px;
    }

    .intro-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 0;
    }

    .intro-actions :global(.cta) {
      width: 100%;
    }

    /* SP は相談 CTA を先に（Figma どおり） */
    .intro-actions :global(.intro-cta-contact) {
      order: -1;
    }

    .reasons {
      background: var(--color-bg-soft);
      padding: 80px 0;
    }

    .reasons-head {
      gap: 6px;
      margin-bottom: 30px;
    }

    .reasons-head :global(.section-heading) {
      display: none;
    }

    .reasons-eyebrow-sp {
      display: block;
      margin: 0;
      font-family: var(--font-en-serif);
      font-weight: 600;
      font-size: 18px;
      letter-spacing: 3.84px;
      color: var(--color-gold);
    }

    .reasons-line-sp {
      display: block;
      width: 24px;
      height: 1px;
      background: var(--color-gold);
      margin: 0 auto 8px;
    }

    .reasons-title-sp {
      display: block;
      margin: 0;
      font-family: var(--font-jp);
      font-weight: 600;
      font-size: 20px;
      letter-spacing: 2px;
      color: var(--color-navy);
    }

    .reasons-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .reason-title-pc,
    .reason-body-pc {
      display: none;
    }

    .reason-title-sp,
    .reason-body-sp {
      display: block;
    }

    .reason-title {
      font-size: 20px;
    }

    .consultations {
      padding: 80px 0;
    }

    .consult-head {
      margin-bottom: 30px;
    }

    .consult-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .consult-en-pc,
    .consult-title-pc,
    .consult-bullets-pc {
      display: none;
    }

    .consult-en-sp,
    .consult-title-sp,
    .consult-bullets-sp {
      display: flex;
    }

    .consult-en-sp {
      display: block;
    }

    .consult-title-sp {
      display: block;
      font-size: 18px;
    }

    .consult-bullets-sp {
      flex-direction: column;
    }

    .flow {
      background: var(--color-bg-soft);
      padding: 80px 0;
    }

    .flow-head {
      align-items: center;
      text-align: center;
      margin-bottom: 30px;
    }

    .flow-lead {
      display: none;
    }

    .flow-step {
      align-items: flex-start;
    }

    .flow-step-body {
      font-size: 14px;
      line-height: 24px;
    }

    .faq {
      background: var(--color-bg);
      padding: 80px 0;
    }

    .faq-list {
      margin-top: 30px;
    }
  }
</style>
